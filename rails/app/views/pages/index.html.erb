<div class="flex justify-end mb-2 text-[.85rem]"><a href="/reports" class="text-accent no-underline hover:underline">Reports →</a></div>
<nav class="flex gap-1.5 mb-[1.2rem] max-sm:gap-1">
  <button id="navReg" class="active <%= ui(:nav) %>">Register</button>
  <button id="navTxn" class="<%= ui(:nav) %>">Add transaction</button>
  <button id="navAcct" class="<%= ui(:nav) %>">Accounts</button>
  <button id="navRec" class="<%= ui(:nav) %>">Reconcile</button>
</nav>

<section id="tabTxn" hidden>
<h1 id="txnTitle" class="<%= ui(:h1) %>">Add transaction</h1>
<div id="editBanner" class="items-center gap-2.5 mb-3.5 px-3 py-2 border border-warn rounded-md max-sm:flex-wrap" style="display:none">
  <span id="editText" class="flex-1"></span>
  <button type="button" id="editCancel" class="<%= ui(:banner_btn) %>">Cancel</button>
  <button type="button" id="editDelete" class="<%= ui(:banner_btn) %> text-bad">Delete</button>
</div>

<div class="<%= ui(:row) %>">
  <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Date</label><input type="date" id="date" class="<%= ui(:field) %> w-full"></div>
  <div class="<%= ui(:cell_110) %>"><label class="<%= ui(:label) %>">Flag</label>
    <select id="flag" class="<%= ui(:field) %> w-full"><option value="!">! pending</option><option value="*">* cleared</option></select></div>
  <div class="<%= ui(:cell) %>"><label class="<%= ui(:label) %>">Payee</label><input id="payee" list="payees" autocomplete="off" class="<%= ui(:field) %> w-full"></div>
  <div class="<%= ui(:cell) %>"><label class="<%= ui(:label) %>">Narration</label><input id="narration" autocomplete="off" class="<%= ui(:field) %> w-full"></div>
</div>
<div class="<%= ui(:row) %>">
  <div class="<%= ui(:cell) %>"><label class="<%= ui(:label) %>">Tags (space separated)</label><input id="tags" class="<%= ui(:field) %> w-full"></div>
  <div class="<%= ui(:cell) %>"><label class="<%= ui(:label) %>">Links</label><input id="links" class="<%= ui(:field) %> w-full"></div>
</div>

<label class="<%= ui(:label) %>">Postings (leave one amount blank to let it balance)</label>
<div id="pWrap" class="relative"><div id="postings"></div><div id="pList" class="<%= ui(:combo) %> right-auto [&_.opt]:whitespace-normal [&_.opt]:wrap-anywhere [&_.opt]:px-[9px] [&_.opt]:py-[5px] max-sm:text-[16px] max-sm:[&_.opt]:px-3 max-sm:[&_.opt]:py-[11px]" style="display:none"></div></div>
<button type="button" id="addPosting" class="<%= ui(:btn) %> max-sm:w-full">+ Add posting</button>
<span id="balance" class="opacity-70 ml-3"></span>

<h2 class="<%= ui(:h2) %>">Preview</h2>
<pre id="preview" class="<%= ui(:pre) %>"></pre>
<div id="status" class="<%= ui(:status) %>"></div>
<button id="save" class="<%= ui(:primary) %> max-sm:w-full max-sm:mt-1.5" disabled>Save</button>

<h2 class="<%= ui(:h2) %>">Recent</h2>
<table id="recent" class="<%= ui(:table) %>"></table>
</section>

<section id="tabAcct" hidden>
<h1 class="<%= ui(:h1) %>">Accounts</h1>
<div id="chips" class="flex gap-1.5 flex-wrap items-center my-2.5"></div>
<div id="acctMsg" role="status" class="mt-1.5 mb-2.5 text-[.9rem] whitespace-pre-wrap empty:hidden data-[tone=ok]:text-ok data-[tone=bad]:text-bad data-[tone=muted]:opacity-70"></div>
<div id="acctEdit" class="border border-line rounded-md px-3 py-2 mt-1.5 mb-3" hidden>
  <h2 id="eTitle" class="text-base font-bold mt-0 mb-[.83em]">Edit account</h2>
  <div class="<%= ui(:hint) %> mb-2.5">You can change the open date of any open account. A new name is only allowed while nothing uses the account yet.</div>
  <div class="<%= ui(:row) %>">
    <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Opened</label><input type="date" id="eDate" class="<%= ui(:field) %> w-full"></div>
    <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Type</label>
      <select id="eType" class="<%= ui(:field) %> w-full"><option>Assets</option><option>Liabilities</option><option>Equity</option><option>Income</option><option>Expenses</option></select></div>
    <div class="<%= ui(:cell_2) %>"><label class="<%= ui(:label) %>">Name (e.g. Bank:Checking)</label><input id="eName" autocomplete="off" class="<%= ui(:field) %> w-full"></div>
  </div>
  <pre id="ePreview" class="<%= ui(:pre) %>"></pre>
  <div id="eStatus" class="<%= ui(:status) %>"></div>
  <button id="eSave" class="<%= ui(:primary) %> max-sm:w-full max-sm:mt-1.5" disabled>Save changes</button>
  <button type="button" id="eCancel" class="<%= ui(:btn) %>">Cancel</button>
</div>
<table id="acctTable" class="<%= ui(:table) %> [&_tr.acct]:cursor-pointer [&_tr.acct:hover]:bg-tint [&_tr.closed_td]:opacity-50 [&_tr.closed_td]:line-through [&_tr.closed_td.act]:opacity-100 [&_tr.closed_td.act]:no-underline [&_td.act]:text-right [&_td.act]:whitespace-nowrap"></table>

<h2 class="<%= ui(:h2) %>">New account</h2>
<div class="<%= ui(:hint) %> mb-2.5">Tip: click an account above to start from its name.</div>
<div class="<%= ui(:row) %>">
  <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Opened</label><input type="date" id="aDate" class="<%= ui(:field) %> w-full"></div>
  <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Type</label>
    <select id="aType" class="<%= ui(:field) %> w-full"><option>Assets</option><option>Liabilities</option><option>Equity</option><option>Income</option><option>Expenses</option></select></div>
  <div class="<%= ui(:cell_2) %>"><label class="<%= ui(:label) %>">Name (e.g. Bank:Checking)</label><input id="aName" autocomplete="off" class="<%= ui(:field) %> w-full"></div>
  <div class="<%= ui(:cell) %>"><label class="<%= ui(:label) %>">Currencies (clear for any)</label><input id="aCur" value="USD" class="<%= ui(:field) %> w-full"></div>
</div>
<pre id="aPreview" class="<%= ui(:pre) %>"></pre>
<div id="aStatus" class="<%= ui(:status) %>"></div>
<button id="aSave" class="<%= ui(:primary) %> max-sm:w-full max-sm:mt-1.5" disabled>Create account</button>
</section>

<section id="tabReg">
<h1 class="<%= ui(:h1) %>">Register</h1>
<div class="<%= ui(:row) %>">
  <div class="<%= ui(:cell) %> relative"><label class="<%= ui(:label) %>">Account</label><input id="gAcct" placeholder="All accounts — type to search" autocomplete="off" class="<%= ui(:field) %> w-full"><div id="gList" class="<%= ui(:combo) %> right-0 [&_.opt]:whitespace-nowrap [&_.opt]:px-[9px] [&_.opt]:py-[5px]" style="display:none"></div></div>
  <div class="<%= ui(:cell_170) %>"><label class="<%= ui(:label) %>">Period</label>
    <select id="gPeriod" class="<%= ui(:field) %> w-full"><option value="all">All</option><option value="this">This month</option><option value="last">Last month</option><option value="last3">Last 3 months</option><option value="custom">Custom month…</option></select></div>
  <div id="gCustom" class="<%= ui(:cell_auto) %>" style="display:none"><label class="<%= ui(:label) %>">Month and year</label>
    <span class="flex gap-1.5 max-sm:w-full"><select id="gMonth" class="<%= ui(:field) %> w-full max-sm:flex-1"></select><input type="number" id="gYear" class="<%= ui(:field) %> w-[90px] max-sm:w-[110px]"></span></div>
  <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Status</label>
    <select id="gStatus" class="<%= ui(:field) %> w-full"><option value="">All</option><option value="pending">Pending !</option><option value="marked">Marked ?</option><option value="cleared">Cleared *</option></select></div>
  <div class="<%= ui(:cell) %>"><label class="<%= ui(:label) %>">Search</label><input id="gSearch" placeholder="Payee, narration, account, amount" autocomplete="off" class="<%= ui(:field) %> w-full"></div>
</div>
<div id="gInfo" class="<%= ui(:hint) %> mb-1.5"></div>
<table id="gTable" class="<%= ui(:table) %> [&_td:first-child]:whitespace-nowrap [&_td.num]:whitespace-nowrap [&_td.num]:pl-[18px] [&_td:nth-child(2)]:w-[40%] [&_td:nth-child(2)]:max-w-0 [&_td:nth-child(2)]:truncate max-sm:[&_td:nth-child(2)]:max-w-[200px]"></table>
<button type="button" id="gMore" class="<%= ui(:btn) %> mt-2.5 max-sm:w-full" style="display:none">Show more</button>
</section>

<section id="tabRec" hidden>
<h1 class="<%= ui(:h1) %>">Reconcile</h1>
<div class="<%= ui(:row) %>">
  <div class="<%= ui(:cell_2) %>"><label class="<%= ui(:label) %>">Account</label><select id="rAcct" class="<%= ui(:field) %> w-full"></select></div>
  <div class="<%= ui(:cell_150) %>"><label class="<%= ui(:label) %>">Statement end date</label><input type="date" id="rDate" class="<%= ui(:field) %> w-full"></div>
  <div class="<%= ui(:cell) %>"><label id="rStmtLabel" class="<%= ui(:label) %>">Statement ending balance</label><input id="rStmt" inputmode="decimal" autocomplete="off" class="<%= ui(:field) %> w-full"></div>
</div>
<div class="<%= ui(:row) %>">
  <div class="<%= ui(:cell_190) %>"><label class="<%= ui(:label) %>">Show period</label>
    <select id="rPeriod" class="<%= ui(:field) %> w-full"><option value="all">All</option><option value="this">This month</option><option value="last">Last month</option><option value="last3">Last 3 months</option><option value="custom">Custom month…</option></select></div>
  <div id="rCustom" class="<%= ui(:cell_auto) %>" style="display:none"><label class="<%= ui(:label) %>">Month and year</label>
    <span class="flex gap-1.5 max-sm:w-full"><select id="rMonth" class="<%= ui(:field) %> w-full max-sm:flex-1"></select><input type="number" id="rYear" class="<%= ui(:field) %> w-[90px] max-sm:w-[110px]"></span></div>
</div>
<div class="<%= ui(:hint) %>">Tick the transactions that appear on the statement. <b>Save progress</b> writes the ticks to the file as <code>?</code> so you can stop and come back. <b>Finish</b> turns them into <code>*</code> once the difference is zero.</div>
<div id="rSum" class="flex gap-[22px] flex-wrap my-3.5 tabular-nums max-sm:gap-3.5 [&_div_span]:block [&_div_span]:text-[.75rem] [&_div_span]:opacity-70 [&_b]:text-[1.05rem] [&_.ok]:text-ok [&_.bad]:text-bad"></div>
<label class="inline-flex items-center gap-1.5 mb-1.5 text-[.8rem]"><input type="checkbox" id="rHide" checked> Hide reconciled <span id="rHidden" class="opacity-70"></span></label>
<label class="inline-flex items-center gap-1.5 mb-1.5 ml-4 text-[.8rem]"><input type="checkbox" id="rHideTicked"> Hide ticked <span id="rHiddenT" class="opacity-70"></span></label>
<div id="rOlder" class="<%= ui(:hint) %> mb-1.5"></div>
<table id="rTable" class="<%= ui(:table) %> [&_tr.pending_td.st]:opacity-60 [&_tr.marked_td.st]:text-warn [&_tr.marked_td.st]:font-semibold [&_tr.cleared]:opacity-60"></table>
<div class="my-3"><label class="inline text-[.8rem]"><input type="checkbox" id="rAssert" class="mr-1.5"><span id="rAssertLabel">Add a balance assertion</span></label></div>
<div id="rStatus" class="<%= ui(:status) %>"></div>
<button id="rSaveBtn" class="<%= ui(:btn) %> max-sm:w-full max-sm:mt-1.5 max-sm:mb-1.5" disabled>Save progress</button>
<button id="rFinish" class="<%= ui(:primary) %> max-sm:w-full max-sm:mt-1.5 max-sm:mb-1.5" disabled>Finish reconciliation</button>
<button type="button" id="rAdd" class="<%= ui(:btn) %> float-right max-sm:float-none max-sm:block max-sm:w-full max-sm:mt-2" title="Add a missing transaction, then return here">+ Add transaction</button>
</section>

<datalist id="payees"></datalist>
<datalist id="accounts"></datalist>

<script>
const $ = id => document.getElementById(id);
// Tailwind class lists shared with the view (app/helpers/ui_helper.rb), and the colour of a status line.
const UI = JSON.parse($('ui-classes').textContent);
const tone = (el, t) => { el.dataset.tone = t || ''; };
let editing = null, delArmed = false, payees = {}, timer = 0, valid = false, allAccounts = [], typeFilter = 'All', textFilter = '', aTimer = 0;
const TYPES = ['Assets', 'Liabilities', 'Equity', 'Income', 'Expenses'];

const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };

function addPosting(p = {}) {
  const el = document.createElement('div');
  el.className = 'posting ' + UI.posting_row;
  el.dataset.orig = p.orig ?? '';
  const fl = p.flag || '';
  el.innerHTML = `<select class="pflag ${UI.field} max-sm:col-start-1" title="Posting flag: blank, ? marked for reconciliation, * reconciled"><option value="">–</option>${fl === '!' ? '<option value="!">!</option>' : ''}<option value="?">?</option><option value="*">*</option></select>
    <input class="acct ${UI.field} max-sm:col-[2/span_4]" placeholder="Account" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
    <input class="amt ${UI.field} max-sm:col-[1/span_2]" placeholder="Amount" inputmode="decimal" autocomplete="off">
    <input class="cur ${UI.field} max-sm:col-start-3" value="USD">
    <button type="button" class="${UI.btn} max-sm:col-start-5" title="Remove">×</button>`;
  el.querySelector('.pflag').value = fl;
  el.querySelector('.acct').value = p.account || '';
  el.querySelector('.amt').value = p.amount || '';
  el.querySelector('.cur').value = p.currency || 'USD';
  el.querySelector('button').onclick = () => { if ($('postings').children.length > 2) { if (el.contains(pc.input)) pcClose(); el.remove(); refresh(); } };
  el.addEventListener('input', refresh);
  $('postings').append(el);
}

function collect() {
  return {
    date: $('date').value, flag: $('flag').value, payee: $('payee').value, narration: $('narration').value,
    tags: $('tags').value, links: $('links').value,
    postings: [...$('postings').children].map(r => ({
      pflag: r.querySelector('.pflag').value, account: r.querySelector('.acct').value, amount: r.querySelector('.amt').value, currency: r.querySelector('.cur').value,
      orig: r.dataset.orig === '' ? null : +r.dataset.orig,
    })),
    ...(editing ? { hash: editing.hash, lineno: editing.lineno } : {}),
  };
}

function updateBalance(d) {
  const sums = {}; let blank = 0;
  for (const p of d.postings) {
    if (!p.account.trim()) continue;
    if (!p.amount.trim()) { blank++; continue; }
    const n = parseFloat(p.amount);
    if (!isNaN(n)) sums[p.currency || 'USD'] = (sums[p.currency || 'USD'] || 0) + n;
  }
  const parts = Object.entries(sums).filter(([, v]) => Math.abs(v) > 1e-9);
  $('balance').textContent = !parts.length ? '' : blank
    ? 'blank posting will be ' + parts.map(([c, v]) => `${(-v).toFixed(2)} ${c}`).join(', ')
    : 'unbalanced by ' + parts.map(([c, v]) => `${v.toFixed(2)} ${c}`).join(', ');
}

async function post(url, body) {
  const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  return { status: r.status, body: await r.json() };
}

function refresh() {
  clearTimeout(timer);
  const d = collect();
  updateBalance(d);
  timer = setTimeout(async () => {
    const { body } = await post(editing ? '/api/transactions/edit/validate' : '/api/validate', d);
    valid = !!body.ok;
    $('preview').textContent = body.text || '';
    tone($('status'), valid ? 'ok' : (body.error ? 'muted' : 'bad'));
    $('status').textContent = valid ? '✓ Valid' : (body.error || body.message || '');
    $('save').disabled = !valid;
  }, 250);
}

async function save() {
  const { body } = await post(editing ? '/api/transactions/edit' : '/api/transactions', collect());
  if (body.error) { tone($('status'), 'bad'); $('status').textContent = body.error; return; }
  const wasEdit = !!editing;
  endEdit();
  loadRecent();
  reset();
  leaveEdit();
  tone($('status'), 'ok');
  $('status').textContent = (wasEdit ? '✓ Changes saved' : '✓ Saved') + ' (backup: ' + body.backup + ')';
}

function reset() {
  for (const id of ['payee', 'narration', 'tags', 'links']) $(id).value = '';
  $('flag').value = '!';
  $('postings').innerHTML = '';
  addPosting(); addPosting();
  $('payee').focus();
  valid = false; $('save').disabled = true;
  $('preview').textContent = '';
}

function prefill() {
  if (editing) return;
  const t = payees[$('payee').value];
  if (!t) return;
  $('narration').value = t.narration;
  $('postings').innerHTML = '';
  t.postings.forEach(addPosting);
  refresh();
}

async function loadRecent() {
  const rows = await (await fetch('/api/recent')).json();
  $('recent').innerHTML = rows.map(t => `<tr><td>${t.date} ${t.flag}</td><td>${descCell(t)}</td>
    <td>${t.postings.map(p => esc(p.account)).join('<br>')}</td>
    <td class="num">${t.postings.map(p => esc(p.amount + ' ' + p.currency)).join('<br>')}</td>
</tr>`).join('');
  wireEditLinks($('recent'));
}
// Description cell: the payee (or narration) is a link that opens the transaction for editing.
function descCell(t) {
  const title = esc(t.payee || t.narration || '(no description)'), sub = t.payee ? `<br><span class="muted" title="${esc(t.narration)}">${esc(t.narration)}</span>` : '';
  return (t.lineno ? `<a href="#" class="lnk" data-edit="${t.lineno}" title="${title}">${title}</a>` : title) + sub;
}
function wireEditLinks(root) {
  root.querySelectorAll('a[data-edit]').forEach(a => a.onclick = e => { e.preventDefault(); startEdit(+a.dataset.edit); });
}
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

(async () => {
  $('date').value = today();
  addPosting(); addPosting();
  const [accts, pay] = await Promise.all([fetch('/api/accounts').then(r => r.json()), fetch('/api/payees').then(r => r.json())]);
  payees = pay;
  setAccounts(accts);
  renderAccounts();
  $('payees').innerHTML = Object.keys(pay).map(p => `<option value="${esc(p)}">`).join('');
  loadRecent();
  refresh();
  initReg();
})();

// ---- accounts tab ----
function acctRank(a) { return TYPES.indexOf(a.account.split(':')[0]); }
// The one account order used everywhere: by type (Assets, Liabilities, Equity, Income, Expenses), then name.
function byAccount(x, y) { return acctRank(x) - acctRank(y) || x.account.localeCompare(y.account); }
function setAccounts(list) { allAccounts = list.sort(byAccount); }

function renderAccounts() {
  $('accounts').innerHTML = allAccounts.filter(a => !a.closed).map(a => `<option value="${esc(a.account)}">`).join('');
  const counts = Object.fromEntries(TYPES.map(t => [t, allAccounts.filter(a => a.account.startsWith(t + ':')).length]));
  $('chips').innerHTML = ['All', ...TYPES].map(t =>
    `<button data-t="${t}" class="${UI.chip} ${t === typeFilter ? 'active' : ''}">${t} ${t === 'All' ? allAccounts.length : counts[t]}</button>`).join('')
    + '<input id="aSearch" class="' + UI.chip_search + '" placeholder="Search accounts" value="' + esc(textFilter) + '">';
  $('chips').querySelectorAll('button').forEach(b => b.onclick = () => { typeFilter = b.dataset.t; renderAccounts(); });
  $('aSearch').oninput = e => { textFilter = e.target.value; renderAccounts(); $('aSearch').focus(); $('aSearch').setSelectionRange(textFilter.length, textFilter.length); };
  const q = textFilter.toLowerCase();
  const rows = allAccounts
    .filter(a => (typeFilter === 'All' || a.account.startsWith(typeFilter + ':')) && a.account.toLowerCase().includes(q))
    .sort(byAccount);
  acctArmed = null;  // re-rendering always disarms a pending delete
  $('acctTable').innerHTML = '<tr class="muted"><td>Account</td><td>Opened</td><td>Currencies</td><td class="num">Balance</td><td></td></tr>' + rows.map(a =>
    `<tr class="acct ${a.closed ? 'closed' : ''}" data-a="${esc(a.account)}"><td>${esc(a.account)}</td><td>${esc(a.open)}${a.closed ? ' – ' + esc(a.closed) : ''}</td>
     <td>${esc(a.currencies.join(', '))}</td>
     <td class="num">${a.balance.map(b => esc(b.amount + ' ' + b.currency)).join('<br>')}</td>
     <td class="act">${a.closed ? '' : '<button type="button" class="aedit ' + UI.pill + '" title="Change the open date or the name">Edit</button> '}<button type="button" class="adel ${UI.pill}" title="Delete this account (only if nothing uses it)">Delete</button></td></tr>`).join('')
    || '<tr><td class="muted">No matching accounts</td></tr>';
  $('acctTable').querySelectorAll('tr.acct').forEach(r => r.onclick = () => {
    const [type, ...rest] = r.dataset.a.split(':');
    $('aType').value = type; $('aName').value = rest.join(':') + ':'; $('aName').focus(); refreshAcct();
  });
  $('acctTable').querySelectorAll('button.adel').forEach(b => b.onclick = e => {
    e.stopPropagation();  // don't also fill the new-account form
    deleteAcct(b, b.closest('tr').dataset.a);
  });
  $('acctTable').querySelectorAll('button.aedit').forEach(b => b.onclick = e => {
    e.stopPropagation();  // don't also fill the new-account form
    startAcctEdit(b.closest('tr').dataset.a);
  });
}

// ---- deleting / closing an account ----
// Two clicks, like deleting a transaction: the first asks the server whether the account is unused,
// the second deletes it. If it is in use, explain why and offer to close it instead.
let acctArmed = null, acctBusy = false;

function setAcctMsg(text, cls) { tone($('acctMsg'), cls || ''); $('acctMsg').textContent = text || ''; }

async function reloadAccounts() {
  setAccounts(await (await fetch('/api/accounts')).json());
  renderAccounts();
  // the account being edited was deleted or closed meanwhile: close the edit panel
  if (acctEdit && !allAccounts.some(a => a.account === acctEdit.account && !a.closed)) endAcctEdit();
}

async function deleteAcct(btn, account) {
  if (acctBusy) return;
  acctBusy = true;
  try {
    if (acctArmed && acctArmed.account === account) {
      const { body } = await post('/api/accounts/delete', { hash: acctArmed.hash, account });
      if (body.error) {
        await reloadAccounts();
        setAcctMsg(body.error, 'bad');  // 409: the list was reloaded, try again
        return;
      }
      await reloadAccounts();
      setAcctMsg(`✓ Deleted ${account} (backup: ${body.backup})`, 'ok');
      return;
    }
    // A different button was armed: put it back first.
    $('acctTable').querySelectorAll('button.adel.armed').forEach(x => { x.classList.remove('armed'); x.textContent = 'Delete'; });
    acctArmed = null;
    setAcctMsg('Checking ' + account + '…', 'muted');
    const { body } = await post('/api/accounts/delete/validate', { account });
    if (body.error) { setAcctMsg(body.error, 'bad'); return; }
    if (body.blocked) { showBlocked(body); return; }
    if (!body.ok) { setAcctMsg(`${account} can't be deleted: rledger would report an error:\n${body.message}`, 'bad'); return; }
    acctArmed = { account, hash: body.hash };
    btn.classList.add('armed'); btn.textContent = 'Click again to delete';
    setAcctMsg(`Will remove this from the ledger:\n${body.removes}` + (body.warning ? `\nNote: ${body.warning}.` : ''), 'muted');
  } finally {
    acctBusy = false;
  }
}

// Explain why an account can't be deleted; offer "Close account" when it has a zero balance.
function showBlocked(v) {
  setAcctMsg(v.message, 'bad');
  if (v.closed) return;
  const box = document.createElement('div');
  box.className = UI.close_box;
  if (!v.can_close) {
    box.textContent = 'You could close it instead once its balance is zero (now ' + v.balance.map(b => b.amount + ' ' + b.currency).join(', ') + ').';
    $('acctMsg').append(box);
    return;
  }
  const label = document.createElement('span');
  label.textContent = 'Close it instead (keeps its history, hides it from pickers) on';
  const date = document.createElement('input');
  date.type = 'date'; date.className = UI.field_small;
  const min = v.last_activity && v.last_activity > v.opened ? v.last_activity : v.opened;
  date.min = min; date.value = today() < min ? min : today();
  const btn = document.createElement('button');
  btn.type = 'button'; btn.className = UI.pill; btn.textContent = 'Close account';
  let armed = false;
  date.oninput = () => { armed = false; btn.textContent = 'Close account'; };
  btn.onclick = async () => {
    if (!armed) { armed = true; btn.textContent = 'Click again to close'; return; }
    btn.disabled = true;
    const { body } = await post('/api/accounts/close', { hash: v.hash, account: v.account, date: date.value });
    if (body.error) { await reloadAccounts(); setAcctMsg(body.error, 'bad'); return; }
    await reloadAccounts();
    setAcctMsg(`✓ Closed ${v.account}: added "${body.text.trim()}" (backup: ${body.backup})`, 'ok');
  };
  box.append(label, date, btn);
  $('acctMsg').append(box);
}

// ---- editing an account (open date and name) ----
// Only the open line changes. The server refuses a new name when anything else mentions the account.
let acctEdit = null, eTimer = 0, eSeq = 0;  // acctEdit = { account, hash }

function startAcctEdit(account) {
  const a = allAccounts.find(x => x.account === account);
  if (!a) return;
  setAcctMsg('');
  acctEdit = { account, hash: null };
  const [type, ...rest] = account.split(':');
  $('eTitle').textContent = 'Edit ' + account;
  $('eDate').value = a.open; $('eType').value = type; $('eName').value = rest.join(':');
  $('ePreview').textContent = '';

  $('eSave').disabled = true;
  $('acctEdit').hidden = false;
  $('acctEdit').scrollIntoView({ block: 'nearest' });
  $('eDate').focus();
}

function endAcctEdit() { clearTimeout(eTimer); eSeq++; acctEdit = null; $('acctEdit').hidden = true; }

function collectAcctEdit() {
  return { account: acctEdit.account, date: $('eDate').value, new_account: $('eType').value + ':' + $('eName').value.trim(), hash: acctEdit.hash };
}

function refreshAcctEdit() {
  if (!acctEdit) return;
  clearTimeout(eTimer);
  eSeq++;  // any check still in flight is now stale, even if it returns inside the 250 ms wait
  $('eSave').disabled = true;
  eTimer = setTimeout(async () => {
    const seq = ++eSeq;
    const { body } = await post('/api/accounts/edit/validate', collectAcctEdit());
    if (seq !== eSeq || !acctEdit) return;  // a newer check started, or the panel was closed
    acctEdit.hash = body.hash || null;
    $('ePreview').textContent = body.text ? `Before: ${body.old}\nAfter:  ${body.text}` : '';
    tone($('eStatus'), body.ok ? 'ok' : 'bad');
    $('eStatus').textContent = body.ok ? '✓ Valid' + (body.warning ? `\nNote: ${body.warning}.` : '') : (body.error || body.message || '');
    $('eSave').disabled = !body.ok;
  }, 250);
}

async function saveAcctEdit() {
  if (!acctEdit || !acctEdit.hash) return;
  $('eSave').disabled = true;
  const { status, body } = await post('/api/accounts/edit', collectAcctEdit());
  if (body.error) {
    tone($('eStatus'), 'bad'); $('eStatus').textContent = body.error;
    if (status === 409) { setAcctMsg(body.error, 'bad'); await reloadAccounts(); refreshAcctEdit(); }
    return;
  }
  endAcctEdit();
  await reloadAccounts();
  setAcctMsg(`✓ Changed "${body.old}" to "${body.text}" (backup: ${body.backup})`, 'ok');
}

function collectAcct() {
  return { date: $('aDate').value, account: $('aType').value + ':' + $('aName').value.trim(), currencies: $('aCur').value };

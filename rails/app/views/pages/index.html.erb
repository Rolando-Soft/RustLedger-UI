// ---- register tab ----
const reg = { txns: [], limit: 200, acct: '' };

async function loadRegister() {
  reg.txns = await (await fetch('/api/register')).json();
  renderRegister();
}

function initReg() {
  fillMonths('gMonth', 'gYear');
  $('gAcct').value = reg.acct;
  reg.limit = 200;

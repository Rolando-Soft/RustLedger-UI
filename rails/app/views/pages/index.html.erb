}

// Status of a transaction, looking only at the chosen account's postings when one is chosen.
function regStatus(t, acct) {
  const ps = acct ? t.postings.filter(p => p.account === acct) : t.postings;
  if (ps.some(p => p.state === 'marked')) return 'marked';
  return ps.every(p => p.state === 'cleared') ? 'cleared' : 'pending';
}

function renderRegister() {
  const acct = reg.acct, q = $('gSearch').value.trim().toLowerCase(), st = $('gStatus').value;
  const { from, end } = periodRange($('gPeriod').value, $('gMonth').value, $('gYear').value);
  $('gCustom').style.display = $('gPeriod').value === 'custom' ? '' : 'none';

  // Running balance over the whole history, so filtering never changes it.
  const after = new Map(), bal = {};
  if (acct) for (const t of reg.txns) {
    for (const p of t.postings.filter(p => p.account === acct)) bal[p.currency] = Math.round(((bal[p.currency] || 0) + num(p.amount)) * 1e6) / 1e6;
    const cur = (t.postings.find(p => p.account === acct) || {}).currency;
    if (cur) after.set(t, { cur, v: bal[cur] });
  }

  const rows = reg.txns.filter(t => {
    if (acct && !t.postings.some(p => p.account === acct)) return false;
    if (from && t.date < from) return false;
    if (end && t.date > end) return false;
    if (st && regStatus(t, acct) !== st) return false;
    if (q && ![t.payee, t.narration, ...t.postings.map(p => p.account + ' ' + p.amount)].join(' ').toLowerCase().includes(q)) return false;
    return true;
  }).reverse();

  const byOrder = byAccount;  // postings within a row follow the account order too
  const mark = p => (p.flag ? `<span class="muted">${esc(p.flag)}</span> ` : '');
  const shown = rows.slice(0, reg.limit);
  $('gTable').innerHTML = `<tr class="muted"><td>Date</td><td>Description</td><td>${acct ? 'Other account' : 'Accounts'}</td><td class="num">Amount</td>${acct ? '<td class="num">Balance</td>' : ''}</tr>`
    + shown.map(t => {
      let accts, amts;
      if (acct) {
        const mine = t.postings.filter(p => p.account === acct);
        accts = t.postings.filter(p => p.account !== acct).sort(byOrder).map(p => esc(p.account)).join('<br>');
        amts = mine.map(p => mark(p) + esc(p.amount + ' ' + p.currency)).join('<br>');
      } else {
        const sorted = t.postings.slice().sort(byOrder);
        accts = sorted.map(p => mark(p) + esc(p.account)).join('<br>');
        amts = sorted.map(p => esc(p.amount + ' ' + p.currency)).join('<br>');
      }
      const b = after.get(t);
      return `<tr><td>${t.date} ${esc(t.flag)}</td><td>${descCell(t)}</td><td>${accts}</td><td class="num">${amts}</td>${acct ? `<td class="num">${b ? money(b.v) + ' ' + esc(b.cur) : ''}</td>` : ''}</tr>`;
    }).join('') || '<tr><td class="muted">No transactions match</td></tr>';
  wireEditLinks($('gTable'));
  $('gMore').style.display = rows.length > shown.length ? '' : 'none';
  $('gMore').textContent = `Show more (${rows.length - shown.length} left)`;
  $('gInfo').textContent = `${rows.length} transaction${rows.length === 1 ? '' : 's'}` + (acct && bal && Object.keys(bal).length ? ' · current balance ' + Object.entries(bal).map(([c, v]) => money(v) + ' ' + c).join(', ') : '');
}

for (const id of ['gPeriod', 'gMonth', 'gYear', 'gStatus']) $(id).addEventListener('change', () => { reg.limit = 200; renderRegister(); });
$('gSearch').addEventListener('input', () => { reg.limit = 200; renderRegister(); });
$('gMore').onclick = () => { reg.limit += 200; renderRegister(); };

// ---- fuzzy account picker (register) ----
// Returns { score, idx } (idx = matched character positions) or null when q doesn't match s.
function fuzzy(q, s) {
  q = q.toLowerCase().replace(/\s+/g, '');
  if (!q) return { score: 0, idx: [] };
  const t = s.toLowerCase(), at = t.indexOf(q);
  if (at >= 0) {  // an exact substring beats any scattered match
    return { score: 1000 - at - (t.length - q.length) * 0.1 + (at === 0 || t[at - 1] === ':' ? 50 : 0), idx: [...q].map((_, i) => at + i) };
  }
  const idx = []; let j = 0, score = 0, prev = -2;
  for (let i = 0; i < t.length && j < q.length; i++) {
    if (t[i] !== q[j]) continue;
    score += (i === prev + 1 ? 5 : 1) + (i === 0 || t[i - 1] === ':' ? 3 : 0);
    idx.push(i); prev = i; j++;
  }
  return j === q.length ? { score: score - t.length * 0.1, idx } : null;
}

const combo = { typing: false, active: 0, shown: [] };
const highlight = (text, idx) => { const on = new Set(idx); return [...text].map((c, i) => on.has(i) ? `<b>${esc(c)}</b>` : esc(c)).join(''); };

function comboRender() {
  const q = combo.typing ? $('gAcct').value.trim() : '';
  let shown;
  if (q) {
    shown = allAccounts.map(a => ({ account: a.account, m: fuzzy(q, a.account) })).filter(x => x.m)
      .sort((x, y) => y.m.score - x.m.score);  // stable sort: ties keep the account order
  } else {
    shown = [{ account: '', label: 'All accounts', m: { idx: [] } }, ...allAccounts.map(a => ({ account: a.account, m: { idx: [] } }))];
  }
  combo.shown = shown;
  combo.active = Math.min(combo.active, Math.max(shown.length - 1, 0));
  $('gList').innerHTML = shown.length
    ? shown.map((x, i) => `<div class="opt ${i === combo.active ? 'active' : ''}" data-i="${i}">${x.label ? esc(x.label) : highlight(x.account, x.m.idx)}</div>`).join('')
    : '<div class="none">No matching accounts</div>';
  $('gList').style.display = '';
  $('gList').querySelector('.opt.active')?.scrollIntoView({ block: 'nearest' });
}

function comboClose() { $('gList').style.display = 'none'; combo.typing = false; $('gAcct').value = reg.acct; }

function comboPick(account) {
  reg.acct = account; reg.limit = 200;
  comboClose();
  renderRegister();
}

$('gAcct').addEventListener('focus', () => { combo.typing = false; combo.active = 0; $('gAcct').select(); comboRender(); });
$('gAcct').addEventListener('input', () => { combo.typing = true; combo.active = 0; comboRender(); });
$('gAcct').addEventListener('blur', () => {
  if (!$('gAcct').value.trim() && reg.acct) comboPick('');  // clearing the box means "all accounts"
  else comboClose();
});
$('gAcct').addEventListener('keydown', e => {
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
    e.preventDefault();
    if ($('gList').style.display === 'none') return comboRender();
    const n = combo.shown.length; if (!n) return;
    combo.active = (combo.active + (e.key === 'ArrowDown' ? 1 : n - 1)) % n; comboRender();
  } else if (e.key === 'Enter') {
    e.preventDefault();
    const x = combo.shown[combo.active]; if (x) comboPick(x.account);
    $('gAcct').blur();
  } else if (e.key === 'Escape') {
    comboClose(); $('gAcct').blur();
  }
});
// mousedown (not click) so the pick lands before the input loses focus
$('gList').addEventListener('mousedown', e => {
  e.preventDefault();
  const el = e.target.closest('.opt'); if (!el) return;
  comboPick(combo.shown[+el.dataset.i].account);
  $('gAcct').blur();
});

// ---- fuzzy account picker (posting account boxes on the Add/Edit form) ----
// One shared list (#pList) shown under whichever posting account box has focus. Open accounts only, in the
// account order. Replaces <datalist id="accounts">, which shows no suggestions in some iOS browsers (Arc Search).
const pc = { input: null, typing: false, active: 0, shown: [] };
const pcOpenAccounts = () => allAccounts.filter(a => !a.closed);

function pcRender() {
  const inp = pc.input, list = $('pList');
  if (!inp || !inp.isConnected) return pcClose();
  const q = pc.typing ? inp.value.trim() : '';
  const shown = q
    ? pcOpenAccounts().map(a => ({ account: a.account, m: fuzzy(q, a.account) })).filter(x => x.m)
        .sort((x, y) => y.m.score - x.m.score)  // stable sort: ties keep the account order
    : pcOpenAccounts().map(a => ({ account: a.account, m: { idx: [] } }));
  pc.shown = shown;
  pc.active = Math.min(pc.active, Math.max(shown.length - 1, 0));
  list.innerHTML = shown.length
    ? shown.map((x, i) => `<div class="opt ${i === pc.active ? 'active' : ''}" data-i="${i}">${highlight(x.account, x.m.idx)}</div>`).join('')
    : '<div class="none">No matching open accounts</div>';
  // place the list right under the focused box (#pWrap is the positioned parent)
  const w = $('pWrap').getBoundingClientRect(), r = inp.getBoundingClientRect();
  list.style.left = (r.left - w.left) + 'px';
  list.style.top = (r.bottom - w.top) + 'px';
  list.style.width = r.width + 'px';
  list.style.display = '';
  // keep the highlighted option visible by scrolling the list only, never the page
  const a = list.querySelector('.opt.active');
  if (a && a.offsetTop < list.scrollTop) list.scrollTop = a.offsetTop;
  else if (a && a.offsetTop + a.offsetHeight > list.scrollTop + list.clientHeight) list.scrollTop = a.offsetTop + a.offsetHeight - list.clientHeight;
}

function pcClose() { $('pList').style.display = 'none'; pc.input = null; pc.typing = false; }

function pcOpen(inp) {
  pc.input = inp; pc.typing = false;
  pc.active = Math.max(pcOpenAccounts().findIndex(a => a.account === inp.value.trim()), 0);  // highlight the current account
  pcRender();
}

function pcPick(account) {
  const inp = pc.input;
  if (!inp || !inp.isConnected) return pcClose();
  inp.value = account;
  pcClose();
  refresh();  // setting .value fires no 'input' event, so update the balance and preview here
  inp.closest('.posting').querySelector('.amt').focus();  // next field: the amount
}

// Event delegation on #postings, so rows added later (addPosting, prefill, edit) work too.
$('postings').addEventListener('focusin', e => {
  if (!e.target.matches('input.acct')) return;
  // the box whose list stayed open after the phone keyboard was hidden: keep its filter and highlight
  if (e.target === pc.input && $('pList').style.display !== 'none') return pcRender();
  pcOpen(e.target);
});
// No focusout handler: hiding the phone keyboard only blurs the box (focus goes nowhere) and the list stays open.
// It closes on a pick, Escape, focus moving to another field (document focusin below), or a tap/click
// elsewhere on the page (document mousedown/touchend below).
$('postings').addEventListener('input', e => { if (e.target === pc.input) { pc.typing = true; pc.active = 0; pcRender(); } });
$('postings').addEventListener('keydown', e => {
  if (e.target !== pc.input) return;
  const open = $('pList').style.display !== 'none';
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
    e.preventDefault();
    if (!open) return pcRender();
    const n = pc.shown.length; if (!n) return;
    pc.active = (pc.active + (e.key === 'ArrowDown' ? 1 : n - 1)) % n; pcRender();
  } else if (e.key === 'Enter') {
    if (!open) return;
    e.preventDefault();
    const x = pc.shown[pc.active]; if (x) pcPick(x.account);
  } else if (e.key === 'Escape') {
    if (open) { e.preventDefault(); $('pList').style.display = 'none'; }
  }
});
// focus moving anywhere else (another field, a reset form) closes the list
document.addEventListener('focusin', e => { if (pc.input && e.target !== pc.input) pcClose(); });
// mousedown: keep the focus in the box (desktop); click: pick (works for taps on phones too).
// A list left open can cover another row's account box. A tap or click on that spot only closes the list:
// nothing is picked and focus does not move (mousedown above), so a second tap on the box opens the list there.
$('pList').addEventListener('mousedown', e => e.preventDefault());
$('pList').addEventListener('click', e => {
  const over = b => { const r = b.getBoundingClientRect(); return r.width > 0 && e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom; };
  if ([...document.querySelectorAll('#postings input.acct')].some(b => b !== pc.input && over(b))) return pcClose();
  const el = e.target.closest('.opt'); if (!el) return;
  const x = pc.shown[+el.dataset.i]; if (x) pcPick(x.account);
});
// rotating the phone or resizing the window moves the box: re-place the open list under it.
// pcRender keeps pc.typing and pc.active; a list hidden with Escape stays hidden.
window.addEventListener('resize', () => { if (pc.input && $('pList').style.display !== 'none') pcRender(); });
// A tap or click anywhere except the list or an account box closes the list. Taps on an account box are left to
// focusin (same box: keep the list; another box: move it there); taps on the list are left to its click handler.
// Mouse: on mousedown. Touch: on touchend, and only for a tap (finger moved 10 px or less), so scrolling the page
// keeps the list open. The row's remove button is not exempt: rows shift when one is removed.
const pcKeepsOpen = t => $('pList').contains(t) || (t instanceof Element && t.matches('input.acct'));
let pcTouch = null;  // where a one-finger touch started; cleared once the finger moves (a scroll, not a tap)
document.addEventListener('mousedown', e => { if (pc.input && !pcKeepsOpen(e.target)) pcClose(); });
document.addEventListener('touchstart', e => { const t = e.touches[0]; pcTouch = e.touches.length === 1 ? { x: t.clientX, y: t.clientY } : null; }, { passive: true });
document.addEventListener('touchmove', e => { const t = e.touches[0]; if (pcTouch && t && Math.hypot(t.clientX - pcTouch.x, t.clientY - pcTouch.y) > 10) pcTouch = null; }, { passive: true });
document.addEventListener('touchend', e => { if (pcTouch && pc.input && !pcKeepsOpen(e.target)) pcClose(); pcTouch = null; });

// ---- reconcile tab ----
const rec = { data: null, ticks: new Set(), busy: false };
const isLiability = () => $('rAcct').value.startsWith('Liabilities:');
const num = v => parseFloat(String(v).replace(/[,$\s]/g, ''));
const money = v => (Math.round(v * 100) / 100).toFixed(2);
const nextDay = d => { const x = new Date(d + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + 1); return x.toISOString().slice(0, 10); };
const serverMarked = () => new Set((rec.data?.rows || []).filter(r => r.state === 'marked').map(r => r.lineno));
const dirtyChanges = () => {
  const was = serverMarked(), out = [];
  for (const r of rec.data?.rows || []) {
    if (r.locked) continue;
    const now = rec.ticks.has(r.lineno), before = was.has(r.lineno);
    if (now !== before) out.push({ lineno: r.lineno, from: before ? '?' : null, to: now ? '?' : null });
  }
  return out;
};

const pad = n => String(n).padStart(2, '0');
const ymd = (y, m, d) => `${y}-${pad(m + 1)}-${pad(d)}`;          // m is 0-based
const monthStart = (y, m) => ymd(y, m, 1);
const monthEnd = (y, m) => ymd(y, m, new Date(y, m + 1, 0).getDate());

// Period -> { from, to, end }. `to` is capped at today (the default statement date);
// `end` is the real last day of the period (a register also shows future-dated entries).
function periodRange(period, month, year) {
  const now = new Date(), y = now.getFullYear(), m = now.getMonth(), t = today();
  const span = (d0, d1, cap) => { const e = monthEnd(d1.getFullYear(), d1.getMonth()); return { from: monthStart(d0.getFullYear(), d0.getMonth()), to: cap && e > t ? t : e, end: e }; };
  switch (period) {
    case 'this': return span(now, now, true);
    case 'last': { const d = new Date(y, m - 1, 1); return span(d, d, false); }
    case 'last3': return span(new Date(y, m - 2, 1), now, true);
    case 'custom': { const d = new Date(+year || y, +month, 1); return span(d, d, true); }
    default: return { from: null, to: t, end: null };
  }
}
const rRange = () => periodRange($('rPeriod').value, $('rMonth').value, $('rYear').value);
const rFrom = () => rRange().from;

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
function fillMonths(monthSel, yearInput) {
  if ($(monthSel).options.length) return;
  $(monthSel).innerHTML = MONTHS.map((n, i) => `<option value="${i}">${n}</option>`).join('');
  $(monthSel).value = new Date().getMonth(); $(yearInput).value = new Date().getFullYear();
}

function applyPeriod() {
  $('rCustom').style.display = $('rPeriod').value === 'custom' ? '' : 'none';
  const { to } = rRange();
  if (to) $('rDate').value = to;
  loadRec(false);
}

function initRec() {
  fillMonths('rMonth', 'rYear');
  const opts = allAccounts.filter(a => !a.closed && /^(Assets|Liabilities):/.test(a.account)).map(a => a.account);
  if ($('rAcct').options.length !== opts.length) {
    $('rAcct').innerHTML = opts.map(a => `<option>${esc(a)}</option>`).join('');
  }
  $('rDate').value ||= today();
  loadRec(true);
}

async function loadRec(resetTicks) {
  const account = $('rAcct').value;
  if (!account) return;
  const r = await fetch('/api/reconcile?account=' + encodeURIComponent(account) + '&through=' + $('rDate').value);
  const body = await r.json();
  if (body.error) { rStatus(body.error, 'bad'); return; }
  rec.data = body;
  rec.ticks = resetTicks ? serverMarked() : new Set([...rec.ticks].filter(n => body.rows.some(x => x.lineno === n && !x.locked)));
  renderRec();
}

function rStatus(msg, cls) { tone($('rStatus'), cls || ''); $('rStatus').textContent = msg; }

function renderRec() {
  const d = rec.data; if (!d) return;
  $('rStmtLabel').textContent = isLiability() ? 'Statement balance (amount owed)' : 'Statement ending balance';
  let ticked = 0, open = 0;
  for (const r of d.rows) { if (!r.locked && rec.ticks.has(r.lineno)) ticked += num(r.amount); if (!r.locked && !rec.ticks.has(r.lineno)) open++; }
  const cleared = num(d.cleared), computed = cleared + ticked;
  const raw = $('rStmt').value.trim();
  const stmt = raw === '' || isNaN(num(raw)) ? null : (isLiability() ? -num(raw) : num(raw));
  const diff = stmt === null ? null : stmt - computed;
  const zero = diff !== null && Math.abs(diff) < 0.005;
  const shown = v => isLiability() ? money(-v) : money(v);
  $('rSum').innerHTML = [['Reconciled', shown(cleared)], ['Ticked', shown(ticked)], ['Computed', shown(computed)],
    ['Statement', stmt === null ? '—' : shown(stmt)], ['Difference', diff === null ? '—' : (zero ? '0.00 ✓' : shown(diff))]]
    .map(([k, v]) => `<div><span>${k}</span><b class="${k === 'Difference' && diff !== null ? (zero ? 'ok' : 'bad') : ''}">${v}</b></div>`).join('')
    + `<div><span>Currency</span><b>${esc(d.currency)}</b></div>`;
  const hide = $('rHide').checked, from = rFrom();
  const inPeriod = r => !from || r.date >= from;
  const hiddenCount = d.rows.filter(r => hide && r.locked && inPeriod(r)).length;
  const older = d.rows.filter(r => !inPeriod(r));
  const olderOpen = older.filter(r => !r.locked && !rec.ticks.has(r.lineno)).length;
  const hideT = $('rHideTicked').checked;
  const isTicked = r => !r.locked && rec.ticks.has(r.lineno);
  const hiddenT = d.rows.filter(r => hideT && isTicked(r) && inPeriod(r)).length;
  $('rHiddenT').textContent = hiddenT ? `(${hiddenT} hidden)` : '';
  $('rHidden').textContent = hiddenCount ? `(${hiddenCount} hidden)` : '';
  $('rOlder').textContent = older.length
    ? `${older.length} earlier transaction(s) not shown` + (olderOpen ? `, ${olderOpen} of them still unreconciled` : '') : '';
  $('rTable').innerHTML = d.rows.filter(r => inPeriod(r) && !(hide && r.locked) && !(hideT && isTicked(r))).map(r => {
    const on = r.locked || rec.ticks.has(r.lineno);
    const st = r.locked ? 'reconciled' : (rec.ticks.has(r.lineno) ? (serverMarked().has(r.lineno) ? 'marked ?' : 'will mark') : 'pending');
    return `<tr class="${r.locked ? 'cleared' : (rec.ticks.has(r.lineno) ? 'marked' : 'pending')}">
      <td><input type="checkbox" data-l="${r.lineno}" ${on ? 'checked' : ''} ${r.locked ? 'disabled' : ''}></td>
      <td>${r.date}</td><td>${esc(r.payee)} <span class="muted">${esc(r.narration)}</span><br><span class="muted">${r.other.map(esc).join(', ')}</span></td>
      <td class="num">${esc(r.amount)}</td><td class="st">${st}</td></tr>`;
  }).join('') || `<tr><td class="muted">${d.rows.length ? 'Nothing to show here (reconciled, ticked or outside the period)' : 'No transactions for this account up to that date'}</td></tr>`;
  $('rTable').querySelectorAll('input[data-l]').forEach(c => c.onchange = () => {
    const n = +c.dataset.l; c.checked ? rec.ticks.add(n) : rec.ticks.delete(n); renderRec();
  });
  const dirty = dirtyChanges().length > 0;
  $('rSaveBtn').disabled = !dirty || rec.busy;
  $('rFinish').disabled = !(zero && rec.ticks.size > 0) || rec.busy;
  $('rAssert').disabled = open > 0;
  if (open > 0) $('rAssert').checked = false;
  $('rAssertLabel').textContent = `Add a balance assertion on ${nextDay($('rDate').value)}` + (open > 0 ? ' (needs every transaction ticked)' : '');
  if (d.ignored_currencies.length) rStatus('Other currencies in this account are not shown: ' + d.ignored_currencies.join(', '), 'muted');
}

async function saveRec() {
  const changes = dirtyChanges();
  if (!changes.length) return true;
  const { status, body } = await post('/api/reconcile/save', { hash: rec.data.hash, account: $('rAcct').value, changes });
  if (body.error) { rStatus(body.error, 'bad'); return false; }
  await loadRec(false);
  return true;
}

async function guarded(fn) {
  rec.busy = true; renderRec();
  try { await fn(); } finally { rec.busy = false; renderRec(); }
}

$('rSaveBtn').onclick = () => guarded(async () => { if (await saveRec()) rStatus('✓ Progress saved', 'ok'); });
$('rFinish').onclick = () => guarded(async () => {
  if (!(await saveRec())) return;
  const raw = $('rStmt').value.trim().replace(/[,$\s]/g, '');
  const statement = isLiability() ? (raw.startsWith('-') ? raw.slice(1) : '-' + raw) : raw;
  const { body } = await post('/api/reconcile/finish', {
    hash: rec.data.hash, account: $('rAcct').value, through: $('rDate').value, statement,
    currency: rec.data.currency, balance_assertion: $('rAssert').checked && !$('rAssert').disabled,
  });
  if (body.error) { rStatus(body.error, 'bad'); return; }
  await loadRec(true);
  loadRecent();
  rStatus(`✓ Reconciled ${body.reconciled} posting(s)` + (body.promoted ? `; ${body.promoted} transaction(s) approved (! → *)` : ''), 'ok');
});
$('rAcct').onchange = () => { $('rStmt').value = ''; loadRec(true); };
$('rDate').onchange = () => loadRec(false);
$('rStmt').oninput = renderRec;
$('rHide').onchange = renderRec;
$('rHideTicked').onchange = renderRec;
$('rPeriod').onchange = applyPeriod;
$('rMonth').onchange = applyPeriod;
$('rYear').onchange = applyPeriod;

for (const id of ['date', 'flag', 'narration', 'tags', 'links']) $(id).addEventListener('input', refresh);
$('payee').addEventListener('input', refresh);
$('payee').addEventListener('change', prefill);
$('addPosting').onclick = () => { addPosting(); };
$('save').onclick = save;
</script>

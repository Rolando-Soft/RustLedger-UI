<%= render "reports/nav" %>
<h1 class="<%= ui(:h1) %>">Statistics</h1>
<p class="<%= ui(:hint) %> mb-3">Entries from <%= @r["first_date"] || "—" %> to <%= @r["last_date"] || "—" %>.</p>
<div class="grid grid-cols-1 gap-x-8 md:grid-cols-2">
  <section>
    <h2 class="<%= ui(:h2_tight) %>">Entries by type</h2>
    <table class="<%= ui(:table) %>">
      <% @r["entries_by_type"].each do |t| %>
        <tr><td><%= t["type"] %></td><td class="num"><%= t["count"] %></td></tr>
      <% end %>
    </table>
  </section>
  <section>
    <h2 class="<%= ui(:h2_tight) %>">Postings per account</h2>
    <table class="<%= ui(:table) %>">
      <% @r["postings_by_account"].each do |a| %>
        <tr><td><%= account_link(a["account"]) %></td><td class="num"><%= a["count"] %></td></tr>
      <% end %>
    </table>
  </section>
</div>
<h2 class="<%= ui(:h2) %>">Balance lines for today</h2>
<p class="<%= ui(:hint) %> mb-2">Current balances of Assets and Liabilities accounts, written as balance assertions you can copy into the ledger.</p>
<pre class="<%= ui(:pre) %>"><%= @r["balance_directives"] %></pre>

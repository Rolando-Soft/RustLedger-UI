<%= render "reports/nav" %>
<h1 class="<%= ui(:h1) %>">Errors</h1>
<% if @r["diagnostics"].empty? %>
  <p class="text-ok">No errors. <code>rledger check</code> found nothing to fix.</p>
<% else %>
  <p class="<%= ui(:hint) %> mb-3"><%= @r["error_count"] %> error(s), <%= @r["warning_count"] %> warning(s), from <code>rledger check</code>.</p>
  <table class="<%= ui(:table) %>">
    <tr class="muted"><td>File</td><td>Line</td><td>Kind</td><td>Code</td><td>Message</td></tr>
    <% @r["diagnostics"].each do |d| %>
      <tr><td><%= d["file"] %></td><td class="num"><%= d["line"] %></td><td class="<%= d["severity"] == "error" ? "text-bad" : "" %>"><%= d["severity"] %></td><td><%= d["code"] %></td><td class="whitespace-normal"><%= d["message"] %></td></tr>
    <% end %>
  </table>
<% end %>

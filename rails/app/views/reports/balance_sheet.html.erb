<%= render "reports/nav" %>
<h1 class="<%= ui(:h1) %>">Balance sheet</h1>
<%= render "reports/period", path: request.path, show_from: false %>
<p class="<%= ui(:hint) %> mb-3"><%= @r["to"] ? "As of the end of #{@r["to"]}" : "Everything in the ledger" %>. Amounts are as they are in the ledger: what you own is positive; what you owe and equity are negative.</p>
<div class="grid grid-cols-1 gap-x-8 md:grid-cols-2">
  <section>
    <h2 class="<%= ui(:h2_tight) %>">Assets</h2>
    <%= render "reports/tree", rows: @r["assets"] %>
    <p class="mt-2 font-semibold tabular-nums">Total assets: <%= amounts_inline(@r["assets_total"]) %></p>
  </section>
  <section>
    <h2 class="<%= ui(:h2_tight) %>">Liabilities</h2>
    <%= render "reports/tree", rows: @r["liabilities"] %>
    <p class="mt-2 font-semibold tabular-nums">Total liabilities: <%= amounts_inline(@r["liabilities_total"]) %></p>
    <h2 class="<%= ui(:h2) %>">Equity</h2>
    <%= render "reports/tree", rows: @r["equity"] %>
    <table class="<%= ui(:table) %>">
      <tr><td>Net income, not yet closed into equity (Income + Expenses)</td><td class="num"><%= amounts(@r["net_income"]) %></td></tr>
    </table>
    <p class="mt-2 font-semibold tabular-nums">Total equity, with net income: <%= amounts_inline(@r["equity_with_income"]) %></p>
  </section>
</div>
<h2 class="<%= ui(:h2) %>">Net worth</h2>
<p class="text-[1.05rem] font-semibold tabular-nums"><%= amounts_inline(@r["net_worth"]) %></p>
<p class="<%= ui(:hint) %>">Assets + Liabilities. Check (Assets + Liabilities + Equity + net income): <%= @r["check"].empty? ? "0, the sheet balances" : "#{amounts_inline(@r["check"])} (not zero because some postings convert currencies with a price or a cost; this app does not add a conversions line)" %>.</p>
<h2 class="<%= ui(:h2) %>">Net worth at each month end</h2>
<table class="<%= ui(:table) %>">
  <tr class="muted"><td>Month</td><td class="num">Net worth</td></tr>
  <% @r["months"].each do |m| %>
    <tr><td><%= m["month"] %></td><td class="num"><%= amounts(m["net_worth"]) %></td></tr>
  <% end %>
</table>

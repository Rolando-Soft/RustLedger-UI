<%= render "reports/nav" %>
<h1 class="<%= ui(:h1) %>">Prices</h1>
<%= render "reports/period", path: request.path, show_from: true %>
<p class="<%= ui(:hint) %> mb-3"><%= period_text(@r) %>. From the ledger's <code>price</code> entries.</p>
<% if @r["pairs"].empty? %>
  <p class="<%= ui(:hint) %>">No prices in this period.</p>
<% end %>
<% @r["pairs"].each do |pair| %>
  <h2 class="<%= ui(:h2_tight) %>"><%= pair["base"] %> in <%= pair["quote"] %></h2>
  <table class="<%= ui(:table) %> mb-4">
    <% pair["prices"].each do |p| %>
      <tr><td class="whitespace-nowrap"><%= p["date"] %></td><td class="num"><%= p["price"] %> <%= pair["quote"] %></td></tr>
    <% end %>
  </table>
<% end %>
